# Copy this file to .env and provide only the values your project needs.
# Do not commit .env or place real secrets in this file.

# ArcGIS portal endpoint (use HTTPS and your organization's approved portal).
ARCGIS_PORTAL_URL=https://www.arcgis.com

# Prefer OAuth, a key vault, or interactive named-user authentication.
# ARCGIS_USERNAME=
# ARCGIS_PASSWORD=
# ARCGIS_API_KEY=

# Behind a corporate TLS-inspecting proxy (e.g. Zscaler), some external hosts
# are intercepted and some aren't. Point both vars at one CA bundle containing
# the public CAs plus your proxy's root cert so requests/urllib calls succeed
# against both kinds of host without disabling verification. See scripts/_env.py.
# SSL_CERT_FILE=/absolute/path/to/combined-ca-bundle.pem
# REQUESTS_CA_BUNDLE=/absolute/path/to/combined-ca-bundle.pem
